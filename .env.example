# Cookie-share-next server configuration.
# Copy to `.env` and replace the placeholder values.

PORT=3000
HOST=0.0.0.0
DB_PATH=./data/cookie-share-next.db

# Public HTTPS origin. OAuth callbacks are generated from this value.
PUBLIC_BASE_URL=https://cookie.nestlone.com

# Admin API token (X-Admin-Token header). Use a long random string.
ADMIN_TOKEN=change-me-long-random

# Comma-separated Chrome extension IDs allowed to receive OAuth results.
# Find the published extension ID in chrome://extensions. Required in production.
ALLOWED_EXTENSION_IDS=kilogkcionjhdmmeafjogdhpoiocgaom

# Configure at least one OAuth provider. A provider with either field missing is disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

DEFAULT_QUOTA_BYTES=104857600
DEFAULT_DAILY_REQUEST_LIMIT=1000
SESSION_TTL_HOURS=720
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MIN=15
REQUEST_LOG_RETENTION_DAYS=7
